{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Myosotis",
  "version": "0.2.0",
  "identifier": "app.myosotis.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "Myosotis",
        "width": 1180,
        "height": 780,
        "minWidth": 360,
        "minHeight": 540,
        "center": true,
        "dragDropEnabled": false,
        "decorations": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "SocialNetworking",
    "shortDescription": "永不忘记你的 AI 伙伴",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
